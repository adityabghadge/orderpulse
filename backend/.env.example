# Copy to `.env` to override defaults. Every setting is optional for local development.
ORDERPULSE_ENVIRONMENT=local
ORDERPULSE_DATABASE_URL=postgresql+psycopg://orderpulse:orderpulse@localhost:5433/orderpulse
ORDERPULSE_CORS_ORIGINS=["http://localhost:5173"]
ORDERPULSE_REDIS_URL=redis://localhost:6380/0
ORDERPULSE_OVERVIEW_CACHE_SECONDS=30
ORDERPULSE_STATS_REFRESH_SECONDS=300
